# ═══════════════════════════════════════════════════════════════════════════════
# CONFIGURAZIONE SERVER - Solo questi valori vanno in .env
# ═══════════════════════════════════════════════════════════════════════════════

# Django
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,example.com,www.example.com

# Database (produzione)
DATABASE_URL=postgres://user:password@db:5432/sld_db
POSTGRES_PASSWORD=your-database-password

# ═══════════════════════════════════════════════════════════════════════════════
# 🔐 CHIAVI PAGAMENTO - Devono stare SOLO qui, MAI nel database
# ═══════════════════════════════════════════════════════════════════════════════

# Modalità pagamento: demo (simulato), sandbox (test), live (produzione)
PAYMENT_MODE=sandbox

# Stripe (pagamenti con carta)
# Trova in: https://dashboard.stripe.com/apikeys
# STRIPE_MODE: sandbox (test), live (produzione), off (disabilitato)
STRIPE_MODE=sandbox
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal
# Trova in: https://developer.paypal.com/developer/applications
# PAYPAL_MODE: sandbox (test), live (produzione), off (disabilitato)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx

# Se STRIPE_MODE=off e PAYPAL_MODE=off, il pagamento è differito via email
# Il pulsante mostrerà "Richiedi appuntamento" invece di "Procedi al pagamento"

# Google Calendar (sincronizzazione disponibilità)
# Trova in: Google Calendar → Impostazioni → Integra calendario → Indirizzo segreto iCal
GOOGLE_CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/xxx/private-xxx/basic.ics

# ═══════════════════════════════════════════════════════════════════════════════
# ⚠️ TUTTE LE ALTRE CONFIGURAZIONI SONO IN SITESETTINGS (Admin Wagtail)
# ═══════════════════════════════════════════════════════════════════════════════
#
# Vai su: Admin Wagtail → Impostazioni → Impostazioni Studio
#
# Le seguenti sezioni sono gestite da SiteSettings:
#
# 📋 DATI STUDIO
#    - Nome studio, avvocato, contatti, indirizzo, social, ecc.
#
# 💳 PRENOTAZIONI
#    - Prezzo e durata consulenze
#
# 📧 EMAIL SMTP
#    - Server, porta, credenziali, indirizzo mittente
#
# 📊 ANALYTICS
#    - Google Analytics 4
#    - Matomo
#
# 📅 GOOGLE CALENDAR
#    - Cache TTL (durata cache)
#
# 📹 VIDEOCHIAMATE
#    - Prefisso stanze Jitsi
#
# ═══════════════════════════════════════════════════════════════════════════════
# Per configurare: esegui setup_demo_data poi modifica in admin
# python manage.py setup_demo_data
# ═══════════════════════════════════════════════════════════════════════════════